wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_wifi_password: "your-ap-password"

# solar-plant (mini-solar-plant)
api_encryption_key: "base64-key-from-openssl-rand-base64-32"

# dreo-nomad (bedroom-smart-fan)
dreo_api_encryption_key: "base64-key-from-openssl-rand-base64-32"
dreo_ota_password: "your-ota-password"

# waveshare-hub75 (waveshare-matrix)
waveshare_hub75_api_encryption_key: "base64-key-from-openssl-rand-base64-32"

# pixel_layout configurator (optional fallback if the UI has no token in local storage)
homeassistant_url: "http://homeassistant.local:8123"
homeassistant_api_key: "long-lived-access-token"
